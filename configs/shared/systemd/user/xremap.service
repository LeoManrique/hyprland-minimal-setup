[Unit]
Description=xremap key remapper (macOS-style Alt=Command)
After=graphical-session.target
PartOf=graphical-session.target

[Service]
Type=simple
# --watch re-grabs devices on hotplug (useful for the wireless G515)
# --mouse also grabs mouse devices, needed for the BTN_MIDDLE->BTN_LEFT remap
ExecStart=/usr/bin/xremap --watch --mouse %h/.config/xremap/config.yml
Restart=on-failure
RestartSec=2

[Install]
WantedBy=graphical-session.target
