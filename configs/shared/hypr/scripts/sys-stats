#!/usr/bin/env bash
# sys-stats <cpu|gpu> — Waybar JSON for the CPU and GPU boxes.
#
#   cpu -> CPU utilization %   (tooltip: model, freq, temp, package power)
#   gpu -> GPU utilization %   (tooltip: temp, VRAM, board power)
#
# CPU package power in the cpu tooltip comes from Intel RAPL
# (/sys/class/powercap). energy_uj is root-only by default; the udev rule
# configs/system/81-rapl-readable.rules makes it readable — without it the cpu
# tooltip simply omits the watt figure (everything else still works).
#
# Percentages and watts are derived from /proc/stat and energy_uj *deltas*
# between consecutive ticks (per-field state files in $XDG_RUNTIME_DIR), so
# there is no in-script sleep. The nvidia-smi call (gpu only) is cached ~2s.
set -euo pipefail

field="${1:-gpu}"
run="${XDG_RUNTIME_DIR:-/tmp}"
rapl="/sys/class/powercap/intel-rapl:0"

read_rapl() { e_now=$(cat "$rapl/energy_uj" 2>/dev/null || echo ""); }
rapl_wrap() { cat "$rapl/max_energy_range_uj" 2>/dev/null || echo 0; }

# ============================================================================
# CPU utilization module  (no nvidia-smi needed)
# ============================================================================
if [[ "$field" == "cpu" ]]; then
  cstate="$run/waybar-cpu.state"          # prev: total idle energy time_ns
  read -r _ u n s idle io irq sirq steal _ < /proc/stat
  total=$(( u + n + s + idle + io + irq + sirq + steal ))
  idle_all=$(( idle + io ))
  now_ns=$(date +%s%N)
  read_rapl

  usage=""; cpw=""
  if [[ -r "$cstate" ]]; then
    read -r p_total p_idle p_e p_t < "$cstate" || true
    if [[ -n "${p_total:-}" ]]; then
      dt=$(( total - p_total )); di=$(( idle_all - p_idle ))
      (( dt > 0 )) && usage=$(awk -v dt="$dt" -v di="$di" 'BEGIN{printf "%.0f",(dt-di)*100/dt}')
      if [[ -n "$e_now" && -n "${p_e:-}" && -n "${p_t:-}" ]]; then
        de=$(( e_now - p_e )); (( de < 0 )) && de=$(( de + $(rapl_wrap) ))
        dtn=$(( now_ns - p_t ))
        (( dtn > 0 )) && cpw=$(awk -v de="$de" -v dt="$dtn" 'BEGIN{printf "%.0f",de/(dt/1e9)/1e6}')
      fi
    fi
  fi
  printf '%s %s %s %s\n' "$total" "$idle_all" "${e_now:-0}" "$now_ns" > "$cstate"

  # package temperature — Intel coretemp "Package id 0", else AMD k10temp "Tctl".
  # hwmon index is not stable, so resolve by chip name + label, not a fixed path.
  temp=""
  for hn in /sys/class/hwmon/hwmon*/name; do
    hd="${hn%/name}"
    case "$(cat "$hn" 2>/dev/null)" in
      coretemp) want="Package id 0" ;;
      k10temp)  want="Tctl" ;;
      *) continue ;;
    esac
    for lf in "$hd"/temp*_label; do
      [[ "$(cat "$lf" 2>/dev/null)" == "$want" ]] || continue
      temp=$(awk '{printf "%.0f",$1/1000}' "${lf%_label}_input"); break 2
    done
  done

  # average current frequency across online cores (kHz -> GHz)
  freq=$(awk '{s+=$1;n++} END{if(n) printf "%.2f",s/n/1e6}' \
    /sys/devices/system/cpu/cpu*/cpufreq/scaling_cur_freq 2>/dev/null || true)
  model=$(sed -n 's/^model name[[:space:]]*: //p' /proc/cpuinfo | head -1 \
    | sed 's/(R)//g; s/(TM)//g; s/  */ /g')

  [[ -z "$usage" ]] && usage=0
  tip="${model:-CPU}  ·  ${usage}% load"
  [[ -n "$freq" ]] && tip="$tip  ·  ${freq} GHz"
  [[ -n "$temp" ]] && tip="$tip  ·  ${temp}°C"
  [[ -n "$cpw"  ]] && tip="$tip  ·  ${cpw} W"
  printf '{"text":"%s%%","percentage":%s,"tooltip":"%s"}\n' "$usage" "$usage" "$tip"
  exit 0
fi

# ============================================================================
# GPU utilization module  (nvidia-smi, cached ~2s)
# ============================================================================
ncache="$run/waybar-nvidia.cache"
if [[ ! -s "$ncache" ]] || (( $(date +%s) - $(stat -c %Y "$ncache" 2>/dev/null || echo 0) >= 2 )); then
  if line=$(nvidia-smi \
      --query-gpu=utilization.gpu,power.draw,temperature.gpu,memory.used,memory.total \
      --format=csv,noheader,nounits 2>/dev/null); then
    printf '%s\n' "$line" > "$ncache.$$" && mv "$ncache.$$" "$ncache"
  fi
fi
IFS=', ' read -r g_util g_power g_temp g_memused g_memtotal < "$ncache" 2>/dev/null || true

if [[ -z "${g_util:-}" ]]; then printf '{"text":"n/a","tooltip":"GPU unavailable"}\n'; exit 0; fi
gpw=$(printf '%.0f' "${g_power:-0}")
tip="GPU ${g_util}%  ·  ${gpw} W  ·  ${g_temp}°C  ·  ${g_memused}/${g_memtotal} MiB VRAM"
printf '{"text":"%s%%","percentage":%s,"tooltip":"%s"}\n' "$g_util" "$g_util" "$tip"
