# ~/.config/dunst/dunstrc — minimal black, monospace, sharp corners
[global]
    monitor = 0
    follow = mouse
    width = 320
    height = (0, 200)
    origin = top-right
    offset = (12, 12)
    notification_limit = 5

    progress_bar = true
    progress_bar_height = 6
    progress_bar_frame_width = 0

    indicate_hidden = yes
    transparency = 0
    separator_height = 1
    padding = 10
    horizontal_padding = 12
    frame_width = 1
    frame_color = "#333333"
    separator_color = frame
    corner_radius = 0
    gap_size = 4

    font = JetBrainsMono Nerd Font 10
    line_height = 2
    markup = full
    format = "<b>%s</b>\n%b"
    alignment = left
    word_wrap = yes
    icon_position = off
    enable_recursive_icon_lookup = false

    mouse_left_click = close_current
    mouse_middle_click = do_action, close_current
    mouse_right_click = close_all

[urgency_low]
    background = "#000000"
    foreground = "#888888"
    timeout = 5

[urgency_normal]
    background = "#000000"
    foreground = "#c5c8c6"
    timeout = 8

[urgency_critical]
    background = "#000000"
    foreground = "#ffffff"
    frame_color = "#cc6666"
    timeout = 0
