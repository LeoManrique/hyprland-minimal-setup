# ~/.config/tofi/config — centered vertical launcher, black, hacker vibes
# Docs: https://github.com/philj56/tofi

# Centered box (vertical list)
anchor = center
horizontal = false
width = 760
height = 820
font = JetBrainsMono Nerd Font
font-size = 24

# Prompt + list
prompt-text = "run: "
num-results = 0          # show as many as fit
result-spacing = 10
min-input-width = 0

# Colors: black bg, monochrome
background-color = #000000
text-color = #c5c8c6
prompt-color = #ffffff
selection-color = #000000
selection-background = #ffffff
selection-background-padding = 6
selection-background-corner-radius = 0
selection-match-color = #cc6666

# Frame / spacing (sharp corners)
outline-width = 0
border-width = 2
border-color = #333333
corner-radius = 0
padding-top = 28
padding-bottom = 28
padding-left = 32
padding-right = 32

# Behaviour
hide-cursor = true
fuzzy-match = true
