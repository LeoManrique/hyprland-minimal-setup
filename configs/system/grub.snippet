# /etc/default/grub — relevant lines for the minimal text GRUB. Edit these,
# then run:  sudo grub-mkconfig -o /boot/grub/grub.cfg

# Text-mode GRUB menu (no graphical theme rendering)
GRUB_TERMINAL_INPUT=console
GRUB_TERMINAL_OUTPUT=console

# Console framebuffer for the GRUB menu
GRUB_GFXMODE=3840x2160,auto
GRUB_GFXPAYLOAD_LINUX=keep

# Kernel cmdline. Just modeset + resume; nothing exotic.
GRUB_CMDLINE_LINUX_DEFAULT="quiet nvidia_drm.modeset=1"

# ---------------------------------------------------------------------------
# NOTE — on mismatched dual monitors, NVIDIA clones the *text console* and
# falls back to a shared 1080p mode while sizing the canvas to 4K, so the GRUB
# menu / login / shutdown text is zoomed into the top-left quarter on both
# screens. This is UNSOLVED. Things that do NOT fix it (don't bother):
#   - video=CONNECTOR:MODE on the cmdline   (NVIDIA ignores it)
#   - GRUB_GFXPAYLOAD_LINUX=text
# And do NOT set `nvidia_drm.fbdev=0`: it black-screened/soft-locked this
# hardware after GRUB. We just live with the cosmetic console issue — the login
# is a plain getty (see SETUP.md Step 4) and Hyprland renders both monitors
# correctly once it starts. See SETUP.md Step 6 for the full write-up.
# ---------------------------------------------------------------------------
