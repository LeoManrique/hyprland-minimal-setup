# Make Intel RAPL energy counters readable by non-root so the waybar `sys-stats`
# script can compute CPU-package power. energy_uj is root-only by default to
# mitigate the PLATYPUS power side-channel (CVE-2020-8694); allowing reads
# re-opens that low-severity *local* channel in exchange for a live power
# readout. Drop this only if you want the power module to include CPU watts.
#
# Deploy to /etc/udev/rules.d/81-rapl-readable.rules, then:
#   sudo udevadm control --reload
#   sudo udevadm trigger --subsystem-match=powercap
ACTION=="add", SUBSYSTEM=="powercap", KERNEL=="intel-rapl:*", RUN+="/usr/bin/chmod a+r %S%p/energy_uj"
